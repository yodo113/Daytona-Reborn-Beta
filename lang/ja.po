msgid "Volume"
msgstr "音量"

msgid "Muet"
msgstr "ミュート"

msgid "Musique"
msgstr "音楽"

msgid "Effets"
msgstr "効果音"

msgid ""
"L'équilibre entre la musique et tout le reste (moteur, dérapages, chocs).\n"
"100 %% et 100 %% : le mélange de la carte son de la borne."
msgstr ""
"音楽とその他の音（エンジン、スキッド、衝突音）のバランスです。\n"
"100 %% と100 %% のとき、アーケードのサウンド基板と同じミックスになります。"

msgid "Son natif (expérimental, réinitialiser)"
msgstr "ネイティブ音声（試験的、再起動が必要）"

msgid "Séquenceur et mixeur natifs ; le son de référence reste disponible pour comparer."
msgstr "ネイティブのシーケンサーとミキサーを使用します。比較用の基準音声も選べます。"

msgid " sur un écran à %.2f Hz"
msgstr "（画面 %.2f Hz）"

msgid "vitesse de la borne, 57,52 images/s%s"
msgstr "アーケード速度、57.52フレーム/秒%s"

msgid "à chaque rafraîchissement"
msgstr "更新ごと"

msgid "tous les %d rafraîchissements"
msgstr "%d 回の更新ごと"

msgid ", vitesse %+.1f %%"
msgstr "、速度 %+.1f %%"

msgid "calé, %.2f images/s, une image %s%s%s"
msgstr "同期中、%.2fフレーム/秒、1フレーム%s%s%s"

msgid "VRR, 57,52 images/s, chacune tenue 17,38 ms%s"
msgstr "VRR、57.52フレーム/秒、各フレーム17.38 ms%s"

